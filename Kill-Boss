--==================================================
-- FUNCIONES
--==================================================

local function GetCharacter()
    return LocalPlayer.Character
end

local function EquipPunch()
    local Character = GetCharacter()

    if not Character then
        return nil
    end

    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

    if not Humanoid or not Backpack then
        return nil
    end

    -- Ya está equipado
    local Punch = Character:FindFirstChild("Punch")

    if Punch and Punch:IsA("Tool") then
        return Punch
    end

    -- Buscar Punch en la mochila
    Punch = Backpack:FindFirstChild("Punch")

    if not Punch then
        return nil
    end

    -- Equipar
    pcall(function()
        Humanoid:EquipTool(Punch)
    end)

    task.wait()

    -- Comprobar nuevamente
    Punch = Character:FindFirstChild("Punch")

    if Punch and Punch:IsA("Tool") then
        return Punch
    end

    return nil
end

--==================================================
-- AUTO PUNCH
--==================================================

task.spawn(function()

    while true do

        if AutoPunch then

            local Punch = EquipPunch()

            if Punch then

                -- Golpear al aire
                pcall(function()
                    Punch:Activate()
                end)

                task.wait(PunchSpeed)

            else
                task.wait(0.1)
            end

        else
            task.wait(0.1)
        end

    end

end)

--==================================================
-- AUTO RULETA
--==================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ReplicatorClient = require(
    ReplicatedStorage
        :WaitForChild("packages")
        :WaitForChild("ReplicatorClient")
)

local Data = ReplicatorClient.get("Data")

local FortuneRemote = ReplicatedStorage
    :WaitForChild("rEvents")
    :WaitForChild("openFortuneWheelRemote")

local Chances = ReplicatedStorage
    .shared
    .catalogs
    .fortuneWheelChances["Fortune Wheel"]

local AutoRuleta = false
local RuletaRunning = false

local function GetSpins()
    local Free = Data:TryIndex({"freeWheelSpins"})
    local Purchased = Data:TryIndex({"purchasedSpins"})

    Free = typeof(Free) == "number" and Free or 0
    Purchased = typeof(Purchased) == "number" and Purchased or 0

    return Free + Purchased
end

local function AutoSpin()
    if RuletaRunning then
        return
    end

    RuletaRunning = true

    while AutoRuleta do

        -- Si no quedan giros, apagar automáticamente
        if GetSpins() <= 0 then
            AutoRuleta = false

            if AutoRuletaButton then
                AutoRuletaButton.Text = "AUTO RULETA  •  OFF"
            end

            break
        end

        local Success = pcall(function()
            FortuneRemote:InvokeServer(
                "openFortuneWheel",
                Chances
            )
        end)

        if not Success then
            task.wait(1)
        else
            task.wait(0.5)
        end
    end

    RuletaRunning = false
end
