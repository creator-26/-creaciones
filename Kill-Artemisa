-- ================== FUNCIONALIDAD DE LA LISTA ==================
local function updatePlayerList()
    for _, child in ipairs(playerList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local noneBtn = Instance.new("TextButton")
    noneBtn.Size = UDim2.new(1, 0, 0, 28)
    noneBtn.BackgroundColor3 = Color3.fromRGB(70, 50, 70)
    noneBtn.Text = "Restablecer Cámara"
    noneBtn.TextColor3 = Color3.new(1,1,1)
    noneBtn.Font = Enum.Font.Gotham
    noneBtn.TextSize = 12
    noneBtn.Parent = playerList
    noneBtn.MouseButton1Click:Connect(function()
        State.SpectatingPlayer = nil
        if LocalPlayer.Character then
            local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
            if humanoid then Camera.CameraSubject = humanoid end
        end
        updatePlayerList()
    end)

    for _, player in pairs(Players:GetPlayers()) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 28)
        btn.Font = Enum.Font.Gotham

        local isMe = player == LocalPlayer
        local isWhitelistedPlayer = isWhitelisted(player)
        local isBlacklistedPlayer = isBlacklisted(player)
        local isSpectating = State.SpectatingPlayer == player

        if isMe then
            btn.BackgroundColor3 = Color3.fromRGB(80, 60, 80)
            btn.Text = player.Name .. " (Tú)"
        elseif isBlacklistedPlayer then
            btn.BackgroundColor3 = Color3.fromRGB(180, 60, 80)  -- Rojo rosado para blacklist
            btn.Text = player.Name .. " ⛔"
        elseif isWhitelistedPlayer then
            btn.BackgroundColor3 = Color3.fromRGB(70, 60, 100)  -- Azul morado para aliados
            btn.Text = player.Name .. " (Aliado)"
        elseif isSpectating then
            btn.BackgroundColor3 = State.AccentColor
            btn.Text = player.Name .. " [Vista]"
            btn.TextColor3 = Color3.new(0,0,0)
        else
            btn.BackgroundColor3 = Color3.fromRGB(70, 60, 80)
            btn.Text = player.Name
        end

        if not isSpectating then btn.TextColor3 = Color3.new(1,1,1) end
        btn.TextSize = 12
        btn.Parent = playerList

        if not isMe then
            btn.MouseButton1Click:Connect(function()
                if not isWhitelistedPlayer and not isBlacklistedPlayer then
                    State.TargetPlayerName = player.Name
                    State.AutoKillAll = false
                    txtTarget.Text = player.Name
                    btnMode.Text = "Modo: Individual"
                    btnMode.BackgroundColor3 = Color3.fromRGB(180, 130, 100)
                end
                State.SpectatingPlayer = player
                updateSpectate()
                updatePlayerList()
            end)
        end

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 4)
        corner.Parent = btn
    end

    playerList.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
end

