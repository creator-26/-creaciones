            for _, n in ipairs(State.Blacklist) do
                if n:lower() == name:lower() then return end
            end
            table.insert(State.Blacklist, name)
            txtBlacklist.Text = ""
            saveBlacklist()
            updateBlacklistUI()
            updatePlayerList()
        end
    end)

    btnBlacklistToggle.MouseButton1Click:Connect(function()
        State.BlacklistAutoKill = not State.BlacklistAutoKill
        if State.BlacklistAutoKill then
            btnBlacklistToggle.Text = "Blacklist Kill: ON"
            btnBlacklistToggle.BackgroundColor3 = Color3.fromRGB(200, 90, 130)
        else
            btnBlacklistToggle.Text = "Blacklist Kill: OFF"
            btnBlacklistToggle.BackgroundColor3 = Color3.fromRGB(70, 50, 80)
        end
    end)

    -- Botón flotante
    local floatBtn = Instance.new("TextButton")
    floatBtn.Size = UDim2.new(0, 45, 0, 45)
    floatBtn.Position = UDim2.new(0.95, -45, 0.05, 0)
    floatBtn.BackgroundColor3 = Color3.fromRGB(25, 18, 30)
    floatBtn.Text = "🌸"
    floatBtn.TextColor3 = State.AccentColor
    floatBtn.TextSize = 20
    floatBtn.Font = Enum.Font.GothamMedium
    floatBtn.Parent = screenGui

    local floatStroke = Instance.new("UIStroke")
    floatStroke.Color = State.AccentColor
    floatStroke.Thickness = 1.5
    floatStroke.Parent = floatBtn

    floatBtn.MouseButton1Click:Connect(function()
        mainFrame.Visible = not mainFrame.Visible
        if mainFrame.Visible then
            updatePlayerList()
            updateBlacklistUI()
        end
    end)

    -- Detección de entrada de jugadores
    Players.PlayerAdded:Connect(function(player)
        if isBlacklisted(player) and State.BlacklistAutoKill then
            task.wait(2)
            local oldAutoKill = State.AutoKillEnabled
            State.AutoKillEnabled = true
            if not State.AttackConnection then startAutoKill() end
            task.delay(3, function()
                State.AutoKillEnabled = oldAutoKill
                if not oldAutoKill and State.AttackConnection then stopAutoKill() end
            end)
        end
        if mainFrame.Visible then
            updatePlayerList()
        end
    end)

    -- Esquinas redondeadas
    local function applyCorners(object, radius)
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, radius)
        corner.Parent = object
    end
    applyCorners(mainFrame, 10)
    applyCorners(titleFrame, 10)
    applyCorners(leftPanel, 8)

    -- Inicialización
    updatePlayerList()
    updateBlacklistUI()
    updateUI()  -- ahora actualiza los botones al iniciar

    task.spawn(function()
        while task.wait(10) do
            if mainFrame.Visible then
                updatePlayerList()
            end
        end
    end)

    print("💖 === PANEL CORREGIDO Y REUBICADO CARGADO ===")
else
    local alertGui = Instance.new("ScreenGui")
    alertGui.Name = "AccessDenied"
    alertGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local alertFrame = Instance.new("Frame")
    alertFrame.Size = UDim2.new(0, 300, 0, 100)
    alertFrame.Position = UDim2.new(0.5, -150, 0.5, -50)
    alertFrame.BackgroundColor3 = Color3.fromRGB(40, 20, 30)
    alertFrame.Parent = alertGui

    local alertText = Instance.new("TextLabel")
    alertText.Size = UDim2.new(1, 0, 1, 0)
    alertText.Text = "ACCESO DENEGADO\nNo tienes permiso para usar este script."
    alertText.TextColor3 = Color3.fromRGB(255, 130, 160)
    alertText.Font = Enum.Font.GothamBold
    alertText.TextSize = 16
    alertText.TextWrapped = true
    alertText.BackgroundColor3 = Color3.fromRGB(40, 20, 30)
    alertText.Parent = alertFrame
end