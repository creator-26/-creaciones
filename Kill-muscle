-- ================== FUNCIONALIDAD DE LA LISTA ==================
local function updatePlayerList()
    for _, child in ipairs(playerList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local noneBtn = Instance.new("TextButton")
    noneBtn.Size = UDim2.new(1, 0, 0, 28)
    noneBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    noneBtn.Text = "Restablecer Cámara"
    noneBtn.TextColor3 = Color3.new(1,1,1)
    noneBtn.Font = Enum.Font.Gotham
    noneBtn.TextSize = 12
    noneBtn.Parent = playerList

    noneBtn.MouseButton1Click:Connect(function()
        State.SpectatingPlayer = nil
        if LocalPlayer.Character then
            local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
            if humanoid then Camera.CameraSubject = humanoid end
        end
        updatePlayerList()
    end)

    for _, player in pairs(Players:GetPlayers()) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 28)
        btn.Font = Enum.Font.Gotham

        local isMe = player == LocalPlayer
        local isWhitelistedPlayer = isWhitelisted(player)
        local isSpectating = State.SpectatingPlayer == player

        if isMe then
            btn.BackgroundColor3 = Color3.fromRGB(40, 80, 40)
            btn.Text = player.Name .. " (Tú)"
        elseif isWhitelistedPlayer then
            btn.BackgroundColor3 = Color3.fromRGB(60, 40, 80)
            btn.Text = player.Name .. " (Aliado)"
        elseif isSpectating then
            btn.BackgroundColor3 = State.AccentColor
            btn.Text = player.Name .. " [Vista]"
            btn.TextColor3 = Color3.new(0,0,0)
        else
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            btn.Text = player.Name
        end

        if not isSpectating then btn.TextColor3 = Color3.new(1,1,1) end
        btn.TextSize = 12
        btn.Parent = playerList

        if not isMe then
            btn.MouseButton1Click:Connect(function()
                if not isWhitelistedPlayer then
                    State.TargetPlayerName = player.Name
                    State.AutoKillAll = false
                    txtTarget.Text = player.Name
                    btnMode.Text = "Modo: Individual"
                    btnMode.BackgroundColor3 = Color3.fromRGB(150, 100, 30)
                end
                State.SpectatingPlayer = player
                updateSpectate()
                updatePlayerList()
            end)
        end
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 4)
        corner.Parent = btn
    end

    playerList.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
end

local function updateBlacklistVisual()
    -- Limpiar lista visual de la blacklist anterior
    for _, child in ipairs(blacklistList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    -- Dibujar cada nombre guardado en la tabla de Blacklist
    for index, name in ipairs(State.Blacklist) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 28)
        btn.Font = Enum.Font.Gotham
        btn.BackgroundColor3 = Color3.fromRGB(80, 40, 40) -- Fondo rojizo de peligro
        btn.Text = name .. " [Quitar]"
        btn.TextColor3 = Color3.new(1,1,1)
        btn.TextSize = 12
        btn.Parent = blacklistList

        -- Si le das clic al nombre en la lista, se elimina de la Blacklist
        btn.MouseButton1Click:Connect(function()
            table.remove(State.Blacklist, index)
            updateBlacklistVisual()
            saveLists()
        end)

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 4)
        corner.Parent = btn
    end

    blacklistList.CanvasSize = UDim2.new(0, 0, 0, blacklistLayout.AbsoluteContentSize.Y)
end
