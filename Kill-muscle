-- ================== SISTEMA DE SEGURIDAD REMOTO ==================
local function isAuthorized()
    local myName = game.Players.LocalPlayer.Name
    
    
    local linkLista = string.char(104, 116, 116, 112, 115, 58, 47, 47, 112, 97, 115, 116, 101, 98, 105, 110, 46, 99, 111, 109, 47, 114, 97, 119, 47, 84, 56, 84, 97, 74, 69, 50, 89) 
    
    -- pcall evita que el script se rompa si no hay internet paste
    local success, content = pcall(function()
        return game:HttpGet(linkLista)
    end)
    
    if success and content then
        -- Comprobamos si el nombre del jugador está dentro del texto que descargamos
        if string.find(string.lower(content), string.lower(myName)) then
            return true
        end
    else
        warn("No se pudo conectar a la lista de usuarios.")
    end
    
    return false
end


-- ================== SISTEMA DE GUARDADO ==================
local function saveLists()
    writefile("AutoKill_Whitelist.json", HttpService:JSONEncode(State.Whitelist))
    writefile("AutoKill_Blacklist.json", HttpService:JSONEncode(State.Blacklist))
end

local function loadLists()
    if isfile("AutoKill_Whitelist.json") then
        State.Whitelist = HttpService:JSONDecode(readfile("AutoKill_Whitelist.json"))
    end
    if isfile("AutoKill_Blacklist.json") then
        State.Blacklist = HttpService:JSONDecode(readfile("AutoKill_Blacklist.json"))
    end
end

